# Copy to .env.local and fill in, or run `vercel env pull .env.local` to get
# these from a linked Vercel project. Nothing here is read at build time — the
# app only needs them at runtime and for the migrate/seed scripts.

# --- Required ---------------------------------------------------------------

# Postgres connection string. Any Postgres works, but the driver is Neon's
# serverless HTTP client, so use a Neon database (Vercel Marketplace → Neon)
# or a Neon-compatible proxy.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Anthropic API key. Extraction runs on Claude Opus 5; with this set the app
# calls the Anthropic API directly and needs no Vercel AI Gateway credits.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY="sk-ant-..."

# --- Optional ---------------------------------------------------------------

# Vercel Blob token, for archiving the original bytes of every uploaded
# document. Without it, uploads still extract and version correctly — the app
# just has no original to link back to. On Vercel this is injected
# automatically once a Blob store is attached to the project.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Override the extraction model. Defaults to claude-opus-5.
# EXTRACTION_MODEL="claude-sonnet-5"
